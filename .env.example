# Client (Vite) — optional; production uses base /mashinals/
# VITE_API_URL=/mashinals/api
# Optional AI name/caption flourish (off by default; app is fully playable without this)
VITE_ENABLE_AI_FLOURISH=false

# Worker — do not commit secrets. Local overrides go in worker/.dev.vars
# CORS_ORIGIN=https://entangleit.com
#
# Deploy: worker/wrangler.jsonc (name: mashinals, routes on entangleit.com/mashinals*)
# D1: mashinals-db
