# Client (Vite) — copy to client/.env.local
VITE_API_URL=http://127.0.0.1:8788
# Optional AI name/caption flourish (off by default; app is fully playable without this)
VITE_ENABLE_AI_FLOURISH=false

# Worker — copy to worker/.dev.vars (no secrets required for local demo)
# CORS_ORIGIN=http://127.0.0.1:45321
