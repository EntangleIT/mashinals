# Client (Vite) — optional; defaults work for same-origin Worker deploy
# VITE_API_URL=/api
# Optional AI name/caption flourish (off by default; app is fully playable without this)
VITE_ENABLE_AI_FLOURISH=false

# Worker — do not commit secrets. Local overrides go in worker/.dev.vars
# CORS_ORIGIN=*
#
# Deploy uses worker/wrangler.jsonc (Worker name: mashinals, D1: mashinals-db).
# After `npm run db:create`, paste the real database_id into wrangler.jsonc.
