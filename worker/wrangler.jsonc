{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mashinals",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  // Path on the EntangleIT zone — same pattern as satpress / bsv-bounties.
  "routes": [
    { "pattern": "entangleit.com/mashinals", "zone_name": "entangleit.com" },
    { "pattern": "entangleit.com/mashinals/*", "zone_name": "entangleit.com" }
  ],
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker must rewrite /mashinals/* → /* before ASSETS.fetch
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mashinals-db",
      "database_id": "c1aefe08-d9f3-41da-86ba-4cc7dcfe9c55",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://entangleit.com"
  }
}
